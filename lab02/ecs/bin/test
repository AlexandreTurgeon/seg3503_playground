#!/bin/bash

# Remove any class files from dist
rm -f ./dist/*.class

# Use the correct classpath separator (':' on Unix/macOS, ';' on Git Bash/Windows)
SEP=":"
case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*) SEP=";" ;;
esac

# Compile the application
javac -encoding UTF-8 --source-path src -d dist src/*.java

# Compile the tests
javac -encoding UTF-8 --source-path test -d dist -cp "dist${SEP}lib/junit-platform-console-standalone-1.7.1.jar" test/*.java

java -jar lib/junit-platform-console-standalone-1.7.1.jar --class-path dist --scan-class-path
